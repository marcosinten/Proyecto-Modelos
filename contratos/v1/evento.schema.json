{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "sesion_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "golpe",
        "inclinacion",
        "vuelco"
      ]
    },
    "gravedad": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta"
      ]
    },
    "estado": {
      "type": "string",
      "enum": [
        "confirmado",
        "cancelado"
      ]
    },
    "t_inicio_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "t_fin_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "t_deteccion_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "t_activacion_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "ubicacion": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "latitud": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitud": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitud",
            "longitud"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "sesion_id",
    "tipo",
    "gravedad",
    "estado",
    "t_inicio_ms",
    "t_fin_ms",
    "t_deteccion_ms",
    "t_activacion_ms",
    "ubicacion"
  ],
  "additionalProperties": false,
  "description": "Contrato v1. Restricciones entre tiempos y orden de muestras se validan adicionalmente en la API. Ver docs/API.md."
}
