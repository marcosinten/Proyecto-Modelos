{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "prueba": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "escenario_esperado": {
              "type": "string",
              "enum": [
                "reposo",
                "marcha",
                "frenada",
                "golpe",
                "inclinacion",
                "vuelco"
              ]
            },
            "repeticion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "nota": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "escenario_esperado",
            "repeticion"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "prueba"
  ],
  "additionalProperties": false,
  "description": "Contrato v1. Restricciones entre tiempos y orden de muestras se validan adicionalmente en la API. Ver docs/API.md."
}
