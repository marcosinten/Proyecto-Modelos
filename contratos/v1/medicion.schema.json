{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "numero": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "t_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ax": {
      "type": "number"
    },
    "ay": {
      "type": "number"
    },
    "az": {
      "type": "number"
    },
    "roll_deg": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "pitch_deg": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    }
  },
  "required": [
    "numero",
    "t_ms",
    "ax",
    "ay",
    "az",
    "roll_deg",
    "pitch_deg"
  ],
  "additionalProperties": false,
  "description": "Contrato v1. Restricciones entre tiempos y orden de muestras se validan adicionalmente en la API. Ver docs/API.md."
}
