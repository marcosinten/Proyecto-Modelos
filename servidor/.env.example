# Usar Node.js 24 LTS. Copiar este archivo a .env solo para cambiar opciones.
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/accidentes.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Para conectar el ESP32: HOST=0.0.0.0, configurar API_KEY y usar una red privada.
# La misma clave se envia en X-API-Key desde el cliente (tambien en consultas).
API_KEY=
