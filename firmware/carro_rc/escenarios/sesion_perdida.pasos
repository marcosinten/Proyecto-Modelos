# API falsa: a los 3 s olvida las sesiones (base borrada); el siguiente lote recibe 404, el firmware vuelve a crear la sesión y reenvía ese lote; después un golpe y su evento.
wait CAL OK
wait SESION id=
delay 3000.0
api reiniciar
delay 2000
set imu1 accelX 2.5
set imu1 accelY 0
set imu1 accelZ 1
delay 300
set imu1 accelX 0
set imu1 accelY 0
set imu1 accelZ 1
delay 1200
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 350
wait /eventos evento
delay 2000
