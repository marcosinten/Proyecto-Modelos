# Golpe y pulsación corta (rearma, sin reiniciar); después el botón se mantiene 3,5 s con un golpe en medio: a los 3 s actuadores en reposo, REINICIO y ESP.restart().
wait CAL OK
wait SESION id=
delay 1000.0
set imu1 accelX 2.5
set imu1 accelY 0
set imu1 accelZ 1
delay 300
set imu1 accelX 0
set imu1 accelY 0
set imu1 accelZ 1
delay 1700
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 3700
set btn_rearme pressed 1
delay 1000
set imu1 accelX 2.5
set imu1 accelY 0
set imu1 accelZ 1
delay 300
set imu1 accelX 0
set imu1 accelY 0
set imu1 accelZ 1
delay 100
expect led1 A 1
delay 2100
set btn_rearme pressed 0
delay 500
mark fin reinicio_boton (no se alcanza: el ESP32 se reinicia antes)
