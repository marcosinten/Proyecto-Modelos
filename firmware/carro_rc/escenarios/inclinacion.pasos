# Inclinación lateral roll = 70° durante 2 s y regreso a 0°; rearme.
wait CAL OK
wait SESION id=
delay 1000.0
set imu1 rotationX 1400.0
set imu1 rotationY -0.0
set imu1 accelX 0.0
set imu1 accelY 0.2419
set imu1 accelZ 0.9703
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.4695
set imu1 accelZ 0.8829
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.6691
set imu1 accelZ 0.7431
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.829
set imu1 accelZ 0.5592
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.9397
set imu1 accelZ 0.342
delay 10
set imu1 rotationX 0
set imu1 rotationY 0
delay 150
expect led1 A 1
delay 1800
set imu1 rotationX -1400.0
set imu1 rotationY -0.0
set imu1 accelX 0.0
set imu1 accelY 0.829
set imu1 accelZ 0.5592
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.6691
set imu1 accelZ 0.7431
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.4695
set imu1 accelZ 0.8829
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.2419
set imu1 accelZ 0.9703
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.0
set imu1 accelZ 1.0
delay 10
set imu1 rotationX 0
set imu1 rotationY 0
delay 1450
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 1700
mark fin inclinacion
