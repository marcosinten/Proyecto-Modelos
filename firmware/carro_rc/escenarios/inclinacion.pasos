# Inclinación lateral roll = 70° durante 2 s y regreso a 0°; rearme.
wait CAL OK
wait SESION id=
delay 1000.0
set imu1 accelX 0.0
set imu1 accelY 0.9397
set imu1 accelZ 0.342
delay 300
expect led1 A 1
delay 1700
set imu1 accelX 0.0
set imu1 accelY 0.0
set imu1 accelZ 1.0
delay 1500
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 1700
mark fin inclinacion
