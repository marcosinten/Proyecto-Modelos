set imu1 accelY 0.0
set imu1 accelZ -1.0
delay 3000
set imu1 accelX 0.0
set imu1 accelY 0.0
set imu1 accelZ 1.0
delay 700
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 1700
mark fin inclinacion_a_vuelco
