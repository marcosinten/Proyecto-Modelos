# Vuelco de costado: roll = 90° (ay = 1 g, az = 0) durante 7 s; rearme volcado; regreso; detector listo.
wait CAL OK
wait SESION id=
delay 1000.0
set imu1 rotationX 1500.0
set imu1 rotationY -0.0
set imu1 accelX 0.0
set imu1 accelY 0.2588
set imu1 accelZ 0.9659
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.5
set imu1 accelZ 0.866
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.7071
set imu1 accelZ 0.7071
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.866
set imu1 accelZ 0.5
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.9659
set imu1 accelZ 0.2588
delay 10
set imu1 accelX 0.0
set imu1 accelY 1.0
set imu1 accelZ 0.0
delay 10
set imu1 rotationX 0
set imu1 rotationY 0
delay 240
expect led1 A 1
delay 5200
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 1200
set imu1 rotationX -1500.0
set imu1 rotationY -0.0
set imu1 accelX 0.0
set imu1 accelY 0.9659
set imu1 accelZ 0.2588
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.866
set imu1 accelZ 0.5
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.7071
set imu1 accelZ 0.7071
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.5
set imu1 accelZ 0.866
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.2588
set imu1 accelZ 0.9659
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.0
set imu1 accelZ 1.0
delay 10
set imu1 rotationX 0
set imu1 rotationY 0
delay 2440
mark fin vuelco_costado
