# Vuelco de costado: roll = 90° (ay = 1 g, az = 0) durante 7 s; rearme volcado; regreso; detector listo.
wait CAL OK
wait SESION id=
delay 1000.0
set imu1 accelX 0.0
set imu1 accelY 1.0
set imu1 accelZ 0.0
delay 300
expect led1 A 1
delay 5200
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 1200
set imu1 accelX 0.0
set imu1 accelY 0.0
set imu1 accelZ 1.0
delay 2500
mark fin vuelco_costado
