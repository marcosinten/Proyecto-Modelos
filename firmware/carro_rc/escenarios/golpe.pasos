# Golpe frontal: ax = 2,5 g (24,5 m/s²) durante 300 ms; rearme 2 s después.
wait CAL OK
wait SESION id=
delay 1000.0
set imu1 accelX 2.5
set imu1 accelY 0
set imu1 accelZ 1
delay 250
expect led1 A 1
delay 50
set imu1 accelX 0
set imu1 accelY 0
set imu1 accelZ 1
delay 2000
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 1900
mark fin golpe
