# Boca abajo: az = -1 g (roll = 180°) durante 4 s; regreso; rearme.
wait CAL OK
wait SESION id=
delay 1000.0
set imu1 accelX 0
set imu1 accelY 0
set imu1 accelZ -1
delay 300
expect led1 A 1
delay 3700
set imu1 accelX 0
set imu1 accelY 0
set imu1 accelZ 1
delay 1000
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 1700
mark fin vuelco_boca_abajo
