# Boca abajo: az = -1 g (roll = 180°) durante 4 s; regreso; rearme.
wait CAL OK
wait SESION id=
delay 1000.0
set imu1 rotationX 1500.0
set imu1 rotationY -0.0
set imu1 accelX 0.0
set imu1 accelY 0.2588
set imu1 accelZ 0.9659
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.5
set imu1 accelZ 0.866
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.7071
set imu1 accelZ 0.7071
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.866
set imu1 accelZ 0.5
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.9659
set imu1 accelZ 0.2588
delay 10
set imu1 accelX 0.0
set imu1 accelY 1.0
set imu1 accelZ 0.0
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.9659
set imu1 accelZ -0.2588
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.866
set imu1 accelZ -0.5
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.7071
set imu1 accelZ -0.7071
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.5
set imu1 accelZ -0.866
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.2588
set imu1 accelZ -0.9659
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.0
set imu1 accelZ -1.0
delay 10
set imu1 rotationX 0
set imu1 rotationY 0
delay 180
expect led1 A 1
delay 3700
set imu1 rotationX -1500.0
set imu1 rotationY -0.0
set imu1 accelX 0.0
set imu1 accelY 0.2588
set imu1 accelZ -0.9659
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.5
set imu1 accelZ -0.866
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.7071
set imu1 accelZ -0.7071
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.866
set imu1 accelZ -0.5
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.9659
set imu1 accelZ -0.2588
delay 10
set imu1 accelX 0.0
set imu1 accelY 1.0
set imu1 accelZ 0.0
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.9659
set imu1 accelZ 0.2588
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.866
set imu1 accelZ 0.5
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.7071
set imu1 accelZ 0.7071
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.5
set imu1 accelZ 0.866
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.2588
set imu1 accelZ 0.9659
delay 10
set imu1 accelX 0.0
set imu1 accelY 0.0
set imu1 accelZ 1.0
delay 10
set imu1 rotationX 0
set imu1 rotationY 0
delay 880
set btn_rearme pressed 1
delay 150
set btn_rearme pressed 0
delay 150
expect led1 A 0
delay 1700
mark fin vuelco_boca_abajo
